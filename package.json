{
  "name": "oto-crawler",
  "version": "1.0.0",
  "description": "Production-grade crawler for oto.com.vn - Ô TÔ CŨ section",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/main.ts",
    "crawl:categories": "ts-node src/main.ts --phase categories",
    "crawl:subcategories": "ts-node src/main.ts --phase subcategories",
    "crawl:queue": "ts-node src/main.ts --phase queue",
    "crawl:run": "ts-node src/main.ts --phase crawl",
    "integrity:check": "ts-node src/scripts/integrity-check.ts",
    "integrity:repair": "ts-node src/scripts/repair-system.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "fs-extra": "^11.2.0",
    "image-size": "^2.0.2",
    "p-limit": "^3.1.0",
    "playwright": "^1.49.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/image-size": "^0.7.0",
    "@types/node": "^20.11.5",
    "@types/uuid": "^9.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
